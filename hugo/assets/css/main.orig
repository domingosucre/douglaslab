@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom component classes */
@layer components {


    /* pagefind */
     .pagefind-ui {
    --pagefind-ui-primary: theme('colors.gray.900');
    --pagefind-ui-text: theme('colors.gray.900');
    --pagefind-ui-background: theme('colors.white');
    --pagefind-ui-border: theme('colors.black');
    --pagefind-ui-tag: theme('colors.gray.100');
     }

  .dark .pagefind-ui {
    --pagefind-ui-primary: theme('colors.gray.100');
    --pagefind-ui-text: theme('colors.gray.100');
    --pagefind-ui-background: theme('colors.slate.800');
    --pagefind-ui-border: theme('colors.slate.600');
    --pagefind-ui-tag: theme('colors.slate.700');
  }

    

    
    
  /* Base button component */
  .btn {
    @apply flex cursor-pointer items-center justify-center border-3 border-black bg-yellow-200
           shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all 
           text-xs md:text-base font-bold px-5 py-2 dark:text-black
           min-h-[44px] min-w-[44px] gap-2 
           focus:outline-none focus:ring-4 focus:ring-blue-500 focus:ring-offset-2
           disabled:opacity-50 disabled:cursor-not-allowed 
           touch-manipulation select-none;
  }

  /* Consolidated button interactions */
  .btn:hover:not(:disabled) {
    @apply translate-x-[3px] translate-y-[3px] shadow-none scale-[0.98];
  }

  .btn:active:not(:disabled) {
    @apply translate-x-[4px] translate-y-[4px] shadow-none scale-[0.96] duration-75;
  }

  .btn:disabled:hover {
    @apply translate-x-0 translate-y-0 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)];
  }

  /* Button variants */
  .btn-primary {
    @apply btn bg-primary text-white hover:bg-primary/90;
  }

  .btn-sm {
    @apply text-xs px-3 py-1 min-h-[40px] min-w-[40px];
  }

  .btn-lg {
    @apply text-lg px-6 py-3 min-h-[56px] min-w-[56px];
  }

  .btn-icon {
    @apply px-3 py-3 aspect-square;
  }

  .btn.loading {
    @apply relative pointer-events-none;
  }

  .btn.loading::after {
    content: '';
    @apply absolute inset-0 bg-current opacity-20;
  }

  /* Card components - consolidated depressable behavior */
  .card {
    @apply w-full border-3 border-black  
           bg-white dark:bg-zinc-900 dark:border-neutral-700;
  }

  .card.depressable {
    @apply transition-all duration-200 ease-out shadow-[8px_8px_0px_rgba(0,0,0,1)];
  }

  .card.depressable:hover {
    @apply translate-x-[3px] translate-y-[3px] shadow-none scale-[1.02];
  }

  .card.depressable:active {
    @apply scale-[0.98];
  }

  .card:focus-within {
    @apply outline-none ring-4 ring-blue-500 ring-offset-2;
  }

  /* Standalone depressable utility (for non-card elements) */
  .depressable:not(.card) {
    @apply transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none;
  }
}

/* Dark mode focus rings */
.dark .btn,
.dark .card:focus-within {
  @apply focus:ring-yellow-400;
}

.dark .btn:focus-visible {
  @apply ring-yellow-400;
}

/* Loading animations */
@keyframes shimmer {
  0% { background-position: -200px 0; }
  100% { background-position: calc(200px + 100%) 0; }
}

.animate-pulse {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200px 100%;
  animation: shimmer 1.5s infinite;
}

.dark .animate-pulse {
  background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
  background-size: 200px 100%;
}

/* Error state styling */
img[style*="opacity: 0.5"] {
  @apply grayscale;
}

/* Responsive adjustments */
@media (max-width: 640px) {
  .card figcaption,
  .card footer {
    @apply px-4;
  }
}

/* Reduced motion support - consolidated */
@media (prefers-reduced-motion: reduce) {
  .btn,
  .card.depressable,
  .depressable,
  .transition-opacity {
    @apply transition-none;
  }
  
  .btn:hover:not(:disabled) {
    @apply translate-x-[1px] translate-y-[1px] shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] scale-100;
  }
  
  .btn:active:not(:disabled) {
    @apply translate-x-[2px] translate-y-[2px] shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] scale-100;
  }
  
  .card.depressable:hover {
    @apply translate-x-[1px] translate-y-[1px] shadow-[6px_6px_0px_rgba(0,0,0,1)] scale-100;
  }
  
  .animate-pulse {
    animation: none;
    @apply bg-gray-300 dark:bg-gray-600;
  }
}




/* FONTS */

@font-face {
  font-display: swap;
  font-family: 'Lexend';
  font-style: normal;
  font-weight: 400;
  src: url('../fonts/lexend-v25-latin-regular.woff2') format('woff2');
}

@font-face {
  font-display: swap;
  font-family: 'Lexend';
  font-style: normal;
  font-weight: 600;
  src: url('../fonts/lexend-v25-latin-600.woff2') format('woff2');
}

@font-face {
  font-display: swap;
  font-family: 'Lexend';
  font-style: normal;
  font-weight: 800;
  src: url('../fonts/lexend-v25-latin-800.woff2') format('woff2');
}

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Your other CSS */
@layer components {
  /* ... */
}
